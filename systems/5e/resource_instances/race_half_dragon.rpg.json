            "name": {
              "value": "Draconic Physiology"
            },
            "source": {
              "value": "homebrew"
            },
            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "Your size is Medium. Half-Dragons stand between six and eight feet tall. Your base walking speed is 30 ft. Half-Dragons typically live up to twice the age of their more mortal side; they mature quickly, easily able to fend for themselves as young as five, and to act like an adult at fifteen, if they so choose. Rollable Height: 5'9\" + 2d10 + 1d8. Rollable weight: 180 + 2d20 + (height roll result × 4)."
                    },
                    "id": "half_dragon_physiology_description"
                  }
                }
              ]
            },
