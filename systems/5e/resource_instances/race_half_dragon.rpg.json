                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "When you use your Breath Weapon, each creature in the area of the exhalation must make a saving throw, the type of which is determined by your Draconic Heritage. The DC for this saving throw equals 8 + your Constitution modifier + your proficiency bonus. A creature takes 2d6 damage on a failed save, and half as much damage on a successful one. The damage increases by 1d6 at 6th, 11th, 16th, and 20th levels. You regain use of this weapon after a short rest."
                    },
                    "id": "half_dragon_breath_weapon_description"
